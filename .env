
# -----------------------------------------------------------------------------
# 1) 프로젝트 루트
# -----------------------------------------------------------------------------
CLIP_HOME=/Users/12609/Documents/hazus

# -----------------------------------------------------------------------------
# 2) 기존 전국 건축물 MASTER DB
# collect_trackb_data_v2.py가 원본으로 읽는 DB입니다.
# -----------------------------------------------------------------------------
CLIP_NATIONWIDE_INTEGRATED_DB=/Users/12609/Documents/hazus/clip_nationwide_integrated_master.db
BUILDING_OUTPUT_TABLE=nationwide_integrated_sheet

# -----------------------------------------------------------------------------
# 3) Track-B 대용량 저장 DB
# 건축물/화재/침수/소방시설/공간 feature는 CORE,
# 대용량 기상 시계열은 WEATHER DB로 분리합니다.
# -----------------------------------------------------------------------------
TRACKB_CORE_DB=/Users/12609/Documents/hazus/clip_trackb_core.db
TRACKB_WEATHER_DB=/Users/12609/Documents/hazus/clip_trackb_weather.db

# -----------------------------------------------------------------------------
# 4) RAW 원본 보존 폴더
# API 원본 JSON, 수입한 evidence 원본 등을 감사/재현용으로 보존합니다.
# -----------------------------------------------------------------------------
TRACKB_RAW_DIR=/Users/12609/Documents/hazus/trackb_raw

# -----------------------------------------------------------------------------
# 5) 대용량 수집 설정
# 25,000건 단위 건축물 처리 / evidence 5,000건 단위 처리.
# 남은 디스크가 1GB 미만이면 collector가 중단하도록 설정합니다.
# -----------------------------------------------------------------------------
TRACKB_BUILDING_CHUNK=25000
TRACKB_EVIDENCE_CHUNK=5000
TRACKB_MIN_FREE_GB=1

# -----------------------------------------------------------------------------
# 6) 모니터 설정
# checkpoint가 아래 시간 이상 갱신되지 않았는데 collector process가 살아 있으면 경고합니다.
# -----------------------------------------------------------------------------
TRACKB_STALL_MINUTES=20

# -----------------------------------------------------------------------------
# 7) 기상청 단기예보 API
# data.go.kr에서 발급받은 서비스키를 그대로 입력하세요.
# 키가 URL-encoded인지 decoded인지 실제 발급 화면 기준으로 사용합니다.
# -----------------------------------------------------------------------------
KMA_SERVICE_KEY=c47560edbb4d856404eaa6d3174ebedd8b9ec24ee0448b87393696006965caad

# -----------------------------------------------------------------------------
# 8) 아래는 향후 실제 endpoint/schema 검증 후 collector에 연결할 키 자리입니다.
# 현재 v2 collector는 이 변수들이 있다고 해서 임의 endpoint를 호출하지 않습니다.
# -----------------------------------------------------------------------------

# 공공데이터포털 공통키를 별도로 관리하고 싶을 때
DATA_GO_KR_SERVICE_KEY=c47560edbb4d856404eaa6d3174ebedd8b9ec24ee0448b87393696006965caad

# 소방청 특정소방대상물/소방시설 API
NFA_SERVICE_KEY=c47560edbb4d856404eaa6d3174ebedd8b9ec24ee0448b87393696006965caad키

# 생활안전지도/침수흔적 관련 인증정보
SAFEMAP_API_KEY=36PZ7VNT-36PZ-36PZ-36PZ-36PZ7VNTBB

# VWorld 등 공간정보를 추가 연결할 경우
VWORLD_API_KEY=DAC43479-80F7-3D5B-9272-43B1BEE04181

# -----------------------------------------------------------------------------
# 9) Track-B 모델/앱 경로
# trackb_app.py와 학습모델이 같은 설정을 사용하도록 합니다.
# -----------------------------------------------------------------------------
CLIP_TRACKB_MODEL_DIR=/Users/12609/Documents/hazus/models_trackb
TRACKB_FIRE_TRAIN_TABLE=trackb_training_fire
TRACKB_FLOOD_TRAIN_TABLE=trackb_training_flood
TRACKB_FIRE_SCORE_TABLE=trackb_score_fire
TRACKB_FLOOD_SCORE_TABLE=trackb_score_flood

# -----------------------------------------------------------------------------
# 10) CatBoost 학습 설정
# -----------------------------------------------------------------------------
CLIP_N_SPLITS=4
CLIP_RANDOM_STATE=42
TRACKB_CATBOOST_ITERATIONS=700
TRACKB_CATBOOST_DEPTH=7
TRACKB_CATBOOST_LR=0.035
TRACKB_MIN_POSITIVE=20
TRACKB_MIN_NEGATIVE=40
TRACKB_SCORE_CHUNK=25000


